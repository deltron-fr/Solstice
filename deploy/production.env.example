# Copy this file to /opt/solstice/.env on the VM and fill in the real values.
# Use the same devnet program ID and test mint used to build the frontend image.
SOLSTICE_IMAGE_TAG=main
SOLSTICE_DOMAIN=solstice.example.com
SOLSTICE_HTTP_ADDR=:8080
SOLSTICE_DATABASE_DSN=file:/data/solstice.db
SOLSTICE_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLSTICE_SOLANA_PROGRAM_ID=replace-with-deployed-devnet-program-id
SOLSTICE_USDC_MINT=replace-with-devnet-test-mint
SOLSTICE_ALLOWED_ORIGINS=https://solstice.example.com
SOLSTICE_SESSION_COOKIE=solstice_session
SOLSTICE_COOKIE_SECURE=true
SOLSTICE_SESSION_TTL=168h
SOLSTICE_CHALLENGE_TTL=5m
SOLSTICE_RECONCILE_INTERVAL=15s
SOLSTICE_UPLOAD_DIR=/data/uploads
